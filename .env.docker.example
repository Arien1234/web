# 复制为项目根目录 .env 后供 docker compose 读取，或把同名变量填进 Dokploy。
# 只保留占位符，不要写入真实密码或密钥，也不要提交填好的 .env。

# MySQL。应用账号不能是 root（官方镜像用 MYSQL_USER 创建）。
DB_NAME=database
DB_USER=lanzhi
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# NestJS
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# 仅前端映射到宿主机的端口。MySQL、Nest、Python 不暴露公网。
FRONTEND_PORT=80
